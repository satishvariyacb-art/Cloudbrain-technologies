  <thead>
    <tr>
      <th style="width: 25%;">Dimension</th>
      <th style="width: 38%;">Cloudbrain Technologies</th>
      <th style="width: 37%;">Traditional Outsourcing Agencies</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><strong>Ownership & Mindset</strong></td>
