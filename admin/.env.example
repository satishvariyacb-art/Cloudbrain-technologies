# API
PORT=5000
# Local MongoDB. The server also sets the database name to cloudbrain.
# Leave MONGODB_URI unset to use server/data/db.json outside production.
MONGODB_URI=mongodb://127.0.0.1:27017/cloudbrain
# Required. Generate a long random value. Do not commit the real value.
JWT_SECRET=replace-with-a-strong-random-secret

# Admin UI (Vite). Do not put JWT_SECRET or MONGODB_URI in frontend code.
VITE_API_URL=http://localhost:5000/api
VITE_WEBSITE_URL=http://localhost:5173

# Used only by scripts/create-admin.js. Omit these from the running API.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=replace-with-a-long-password
# ADMIN_NAME=CloudBrain Admin
